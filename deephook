= CRYSTALSHARD.GD (Area3D)
===========================================================
extends Area3D

func _ready():
    body_entered.connect(_on_body_entered)

func _on_body_entered(body):
    if body.is_in_group("player"):
        if body.has_method("add_item"):
            body.add_item("crystal_shard", 1)
        queue_free()


===========================================================
= CAVECRAWLER.GD (CharacterBody3D)
===========================================================
extends CharacterBody3D

@export var move_speed := 3.0
@export var detection_radius := 12.0
@export var damage := 10

var player: CharacterBody3D

func _ready():
    player = get_tree().get_first_node_in_group("player")

func _physics_process(delta):
    if not player:
        return

    var to_player = player.global_transform.origin - global_transform.origin
    if to_player.length() > detection_radius:
        return

    var dir = to_player.normalized()
    velocity = dir * move_speed
    move_and_slide()

    if to_player.length() < 1.5:
        if player.has_method("take_damage"):
            player.take_damage(damage)


===========================================================
= CRYSTALGOLEM.GD (CharacterBody3D)
===========================================================
extends CharacterBody3D

@export var move_speed := 1.5
@export var detection_radius := 18.0
@export var damage := 20
@export var crystal_drop_scene: PackedScene

var player: CharacterBody3D
var health := 100

func _ready():
    player = get_tree().get_first_node_in_group("player")

func _physics_process(delta):
    if not player:
        return

    var to_player = player.global_transform.origin - global_transform.origin
    if to_player.length() > detection_radius:
        return

    var dir = to_player.normalized()
    velocity = dir * move_speed
    move_and_slide()

    if to_player.length() < 2.0:
        if player.has_method("take_damage"):
            player.take_damage(damage)

func take_damage(amount: int):
    health -= amount
    if health <= 0:
        die()

func die():
    if crystal_drop_scene:
        var drop = crystal_drop_scene.instantiate()
        drop.global_transform.origin = global_transform.origin
        get_tree().current_scene.add_child(drop)
    queue_free()

