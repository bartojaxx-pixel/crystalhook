===========================================================
= CRYSTALBOMB.GD (RigidBody3D)
===========================================================
extends RigidBody3D

@export var fuse_time := 2.0
@export var blast_radius := 6.0
@export var blast_force := 20.0

func _ready():
    await get_tree().create_timer(fuse_time).timeout
    explode()

func explode():
    var space_state = get_world_3d().direct_space_state
    var query = PhysicsShapeQueryParameters3D.new()
    query.transform = global_transform
    query.shape = CollisionShape3D.new().shape
    var bodies = space_state.intersect_shape(query)

    for b in bodies:
        if b.collider is CharacterBody3D:
            var push = (b.collider.global_transform.origin - global_transform.origin).normalized()
            b.collider.velocity += push * blast_force

    queue_free()


